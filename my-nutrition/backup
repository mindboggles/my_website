function ajax(url, functionName) 
{
    var xmlhttprequest = new XMLHttpRequest();

    xmlhttprequest.onreadystatechange = function() {
        if (this.readyState == 4 && this.status == 200) {
            functionName(this);
        }
    }

    xmlhttprequest.open("GET", url, true);
    xmlhttprequest.send();
}








function display(xhr) {
    var tables = document.getElementById("food-tables");

    while(tables.hasChildNodes()) {
        tables.removeChild(tables.firstChild);
    }

    var txt = xhr.responseText;
    var dataArrays = txt.split("-----");

    for(let i = 1; i < dataArrays.length; i++) { // i = 1, because "var dataArrays = txt.split("-----");" creates empty value under 0 index
        let dataArray = dataArrays[i].split("/");
        var titles = ["Name", "Brand", "Cookedness", "GI", "Grams", "Calories", "Total Fat", "Saturated Fat", "Total Carbohydrate", "Dietary Fiber", "Protein"];
        var newTable = document.createElement("table");
        
        for(let j = 0; j < dataArray.length; j++) {
            let row = document.createElement("tr");
            let title = document.createElement("th");
            let value = document.createElement("td");

            if(dataArray[j] != "NULL") {
                title.innerHTML = titles[j];
                value.innerHTML = dataArray[j];

                row.appendChild(title);
                row.appendChild(value);
                newTable.appendChild(row);
            }   
        }

        tables.appendChild(newTable);
    }
}








function select(xhr, idParameter) 
{
    var xml = xhr.responseXML;
    var tables = xml.getElementsByTagName("table");

    for(let i = 0; i < tables.length; i++) {
        var columns = tables[i].getElementsByTagName("column");
        var id = columns[0].childNodes[0].nodeValue;

        if(id == idParameter) {
            var name = columns[1].childNodes[0].nodeValue;
            var brand = columns[2].childNodes[0].nodeValue;
            var cookedness = columns[3].childNodes[0].nodeValue;
            var gi = columns[4].childNodes[0].nodeValue;
            var grams = columns[5].childNodes[0].nodeValue;
            var calories = columns[6].childNodes[0].nodeValue;
            var totalFat = columns[7].childNodes[0].nodeValue;
            var satFat = columns[8].childNodes[0].nodeValue;
            var carbs = columns[9].childNodes[0].nodeValue;
            var fiber = columns[10].childNodes[0].nodeValue;
            var protein = columns[11].childNodes[0].nodeValue;
            var selectRequest = new XMLHttpRequest();

            selectRequest.onreadystatechange = function() {
                if(this.readyState == 4 && this.status == 200) {
                    window.location.reload()
                }
            }

            selectRequest.open("GET", "select.php?name="+name+"&brand="+brand+"&cookedness="+cookedness+"&gi="+gi+"&grams="+grams+"&calories="+calories+"&totalFat="+totalFat+"&satFat="+satFat+"&carbs="+carbs+"&fiber="+fiber+"&protein="+protein, true);
            selectRequest.send();
        }
    }
}








