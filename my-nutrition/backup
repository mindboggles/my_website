function suggest(xlr) 
{
    var previousSuggestions = document.getElementById("suggestions-div");

    while (previousSuggestions.hasChildNodes()) {
        previousSuggestions.removeChild(previousSuggestions.firstChild);
    }

    var input = document.getElementById("food-search").value;
    input = input.replace(/[^a-zA-Z āčēģīķļņšūž]/g, "");

    if (input != "" && input != " ") {
        let xlm = xlr.responseXML;
        let tables = xlm.getElementsByTagName("table");

        for(let i = 0; i < tables.length; i++) {
            let table = tables[i];
            let columns = table.getElementsByTagName("column");
            let id = columns[0].childNodes[0].nodeValue;
            let name = columns[1].childNodes[0].nodeValue;
            let brand = columns[2].childNodes[0].nodeValue;
            let cookedness = columns[3].childNodes[0].nodeValue;

            if (name.toLowerCase().search(input) != -1 || brand.toLowerCase().search(input) != -1) {
                console.log([id, name, brand, cookedness]);

                let parent = document.getElementById("suggestions-div");
                let child = document.createElement("input");

                child.type = "button"; 
                child.value = name + ", " + brand + ", " + cookedness;
                child.id = "suggestion";

                function testing() {
                    document.addEventListener("click", ajax("select.php?food="+name, select));
                }

                child.addEventListener('click', testing);

                parent.appendChild(child);
            }
        }
    }
}








